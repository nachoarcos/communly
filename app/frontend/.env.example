# Copiar a .env.local para desarrollo, o inyectar como variables de
# entorno en el paso de build del pipeline (ver .github/workflows/app-deploy.yml).
# Vite solo expone al bundle las variables con prefijo VITE_.

# URL base de la API, servida por CloudFront bajo /api (ver
# modules/storage/cloudfront.tf). En local, si no usas el proxy de
# CloudFront, puede apuntar directo al invoke_url de API Gateway.
VITE_API_BASE_URL=https://<tu-distribucion>.cloudfront.net/api

# Dominio del Hosted UI de Cognito (output hosted_ui_domain del modulo cognito)
VITE_COGNITO_DOMAIN=https://communly-prod.auth.eu-west-1.amazoncognito.com

# App Client de Cognito (output user_pool_client_id)
VITE_COGNITO_CLIENT_ID=

# Debe coincidir EXACTAMENTE con una entrada de var.callback_urls /
# var.logout_urls en envs/prod/variables.tf
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_LOGOUT_URI=http://localhost:5173
